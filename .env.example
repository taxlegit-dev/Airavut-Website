# PostgreSQL connection used by Prisma. Apply prisma/migrations manually in your deployment workflow.
DATABASE_URL=postgresql://postgres:123456@localhost:5432/airavut?schema=public

# Public canonical origin
NEXT_PUBLIC_SITE_URL="https://airavut.com"

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Admin authentication. Generate the hash with: npm run admin:hash -- "your-long-password"
ADMIN_EMAIL="admin@local.com"
ADMIN_PASSWORD_HASH="scrypt\$xMwVkkXil4Y2rQFq1ToiLw\$_fXpVssYs4qUqr89Ob08sTr_2CLz8_OB8zumW_neahH_TJynrrLIFFP21Neu4s2kvC7K5lP84szHOl6tw71H3Q"

SESSION_SECRET="replace-with-at-least-32-random-characters"

# Transactional email via Resend
RESEND_API_KEY=""
EMAIL_FROM="Airavut <inquiries@your-verified-domain.example>"
INQUIRY_NOTIFICATION_EMAIL="learn@airavut.com"

# Ikigai vertical sites. Leave empty to show the built-in "Coming soon" page at /ikigai-exams and
# /ikigai-publishing; set to the live domain (full https:// URL) to redirect there. Requires a rebuild.
IKIGAI_EXAMS_URL=""
IKIGAI_PUBLISHING_URL=""

# Phone OTP verification via MSG91 (OTP API + an approved DLT template containing ##OTP##).
# Without these, codes are shown on screen and logged instead of sent: always in development,
# and in production only if OTP_TEST_MODE="true" (never enable that on the live site).
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""
OTP_TEST_MODE=""
# Set to "false" to turn phone OTP off on both forms (e.g. until MSG91/DLT is approved). Requires a rebuild.
OTP_REQUIRED=""
