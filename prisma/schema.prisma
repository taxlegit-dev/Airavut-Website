generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_REVIEW
  CLOSED
}

model Inquiry {
  id                 String         @id @default(uuid()) @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  fullName           String         @map("full_name") @db.VarChar(100)
  email              String         @db.VarChar(254)
  phone              String         @db.VarChar(20)
  organisation       String         @db.VarChar(150)
  area               String         @db.VarChar(100)
  message            String         @db.VarChar(2000)
  status             InquiryStatus  @default(NEW)
  ipHash             String         @map("ip_hash") @db.Char(64)
  duplicateKey       String         @unique(map: "inquiries_duplicate_key_key") @map("duplicate_key") @db.Char(64)
  emailDeliveryError String?        @map("email_delivery_error") @db.VarChar(500)
  auditLogs          AuditLog[]

  @@index([createdAt(sort: Desc)], map: "inquiries_created_at_idx")
  @@index([status, createdAt(sort: Desc)], map: "inquiries_status_created_at_idx")
  @@index([area], map: "inquiries_area_idx")
  @@index([ipHash, createdAt], map: "inquiries_ip_hash_created_at_idx")
  @@map("inquiries")
}

model AuditLog {
  id         BigInt    @id @default(autoincrement())
  inquiryId  String?   @map("inquiry_id") @db.Uuid
  actor      String    @db.VarChar(254)
  action     String    @db.VarChar(80)
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  inquiry    Inquiry?  @relation(fields: [inquiryId], references: [id], onDelete: SetNull)

  @@index([inquiryId, createdAt(sort: Desc)], map: "audit_logs_inquiry_id_created_at_idx")
  @@map("audit_logs")
}

model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  ipHash    String   @map("ip_hash") @db.Char(64)    
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ipHash, createdAt], map: "login_attempts_ip_hash_created_at_idx")
  @@map("login_attempts")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique(map: "admin_users_email_key") @db.VarChar(254)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String?   @db.VarChar(100)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("admin_users")
}

enum CareerApplicationStatus {
  NEW
  IN_REVIEW
  SHORTLISTED
  REJECTED
}

model CareerApplication {
  id           String                  @id @default(uuid()) @db.Uuid
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  fullName     String                  @map("full_name") @db.VarChar(100)
  email        String                  @db.VarChar(254)
  phone        String                  @db.VarChar(20)
  location     String                  @db.VarChar(120)
  linkedinUrl  String                  @map("linkedin_url") @db.VarChar(500)
  resumeUrl    String                  @map("resume_url") @db.VarChar(1000)
  portfolioUrl String?                 @map("portfolio_url") @db.VarChar(1000)
  experience   String                  @db.VarChar(40)
  role         String                  @db.VarChar(40)
  noticePeriod String                  @map("notice_period") @db.VarChar(20)
  whyJoinUs    String                  @map("why_join_us") @db.VarChar(2000)
  status       CareerApplicationStatus @default(NEW)
  ipHash       String                  @map("ip_hash") @db.Char(64)
  fingerprint  String                  @unique(map: "career_applications_fingerprint_key") @db.Char(64)

  @@index([createdAt(sort: Desc)], map: "career_applications_created_at_idx")
  @@index([status, createdAt(sort: Desc)], map: "career_applications_status_created_at_idx")
  @@index([role], map: "career_applications_role_idx")
  @@index([experience], map: "career_applications_experience_idx")
  @@index([email], map: "career_applications_email_idx")
  @@index([ipHash, createdAt], map: "career_applications_ip_hash_created_at_idx")
  @@map("career_applications")
}

// Phone OTP challenges for the public forms. Only hashes are stored; rows can be purged after a day.
model OtpVerification {
  id         String    @id @default(uuid()) @db.Uuid
  phoneHash  String    @map("phone_hash") @db.Char(64)
  codeHash   String    @map("code_hash") @db.Char(64)
  ipHash     String    @map("ip_hash") @db.Char(64)
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneHash, createdAt(sort: Desc)], map: "otp_verifications_phone_hash_created_at_idx")
  @@index([ipHash, createdAt], map: "otp_verifications_ip_hash_created_at_idx")
  @@map("otp_verifications")
}
